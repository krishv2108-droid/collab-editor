# Copy this file to .env and adjust. .env is gitignored; this example is committed.

# Port the WebSocket server listens on.
PORT=8080

# Where documents are stored. Postgres.app on a Mac accepts your macOS username with no password.
DATABASE_URL=postgres://localhost:5432/collab_editor

# A separate database for tests, so running them never touches real documents.
TEST_DATABASE_URL=postgres://localhost:5432/collab_editor_test
